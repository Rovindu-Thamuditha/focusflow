
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and reuse of logic.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'rovinduthamu@gmail.com' || request.auth.token.email == 'rovindu2007@gmail.com');
    }

    // Check if current user is friends with target user
    function isFriend(userId) {
      let friendshipId1 = request.auth.uid < userId ? request.auth.uid + "_" + userId : userId + "_" + request.auth.uid;
      // Alternatively, check the relationships collection if exists, but we use search query usually.
      // For simplicity in this ruleset, we check for an accepted friendship document.
      // We'll use a more generic check based on the 'friendships' collection.
      return exists(/databases/$(database)/documents/friendships/$(request.auth.uid + "_" + userId)) || 
             exists(/databases/$(database)/documents/friendships/$(userId + "_" + request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow write: if isOwner(userId);
      
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn()
                      && userId != request.auth.uid 
                      && request.resource.data.fromUserId == request.auth.uid
                      && (request.resource.data.type == 'friend_request' || request.resource.data.type == 'friend_accept');
      }

      match /daily_summaries/{date} {
        // Allow reading summaries if owner OR if friend AND friend has shared focus time
        allow read: if isOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.privacy.shareTotalFocusTime == true);
        allow write: if isOwner(userId);
      }
      
      match /{subcollection}/{docId} {
         allow read, write: if isOwner(userId);
      }
    }
    
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      
      allow create: if isSignedIn() 
                && request.resource.data.status == 'pending' 
                && request.auth.uid in request.resource.data.userIds 
                && request.auth.uid == request.resource.data.requesterId
                && request.resource.data.userIds.size() == 2
                && request.resource.data.userIds[0] != request.resource.data.userIds[1];

      allow update: if isSignedIn() 
                && resource.data.status == 'pending' 
                && request.auth.uid in resource.data.userIds
                && request.auth.uid != resource.data.requesterId
                && request.resource.data.status == 'accepted';

      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    match /dailyQuestions/{dailyQuestionId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    match /whatsnew/{whatsNewId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
