
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and reuse of logic.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // In a real app, use custom claims for roles: request.auth.token.admin == true
      return isSignedIn() && request.auth.token.email == 'rovinduthamu@gmail.com';
    }

    // Function to check if two users are friends by checking for an 'accepted' friendship document.
    function areFriends(userId1, userId2) {
      // This is a simplified check. A robust implementation would query the friendships collection.
      // For security rules, you'd typically check a field on a user document or use exists() on a specific path.
      // This function is illustrative for client-side logic but complex for direct rule use without specific document paths.
      return false; 
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Allow authenticated users to write to another user's notifications ONLY for friend requests
      match /notifications/{notificationId} {
        // Allow the recipient (userId) to read and delete their own notifications
        allow read, update, delete: if isOwner(userId);

        allow create: if isSignedIn()
                      // 1. The document type must be 'friend_request'
                      && request.resource.data.type == 'friend_request'
                      // 2. The recipient (path variable {userId}) is NOT the sender (request.auth.uid)
                      && userId != request.auth.uid 
                      // 3. The authenticated user must be the 'fromUserId' defined in the request data
                      && request.resource.data.fromUserId == request.auth.uid; 
      }
      
      // This secures all OTHER subcollections like /todos, /settings, /privacy, etc.
      match /{subcollection}/{docId} {
         allow read, write: if isOwner(userId);
      }
    }
    
    /**
     * @description
     *   Manages friendship connections. Users can send requests, and recipients can accept/decline.
     * @path /friendships/{friendshipId}
     */
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      
      allow create: if isSignedIn() 
                // 1. Must be a pending status for creation
                && request.resource.data.status == 'pending' 
                // 2. The authenticated user must be listed as one of the two user IDs
                && request.auth.uid in request.resource.data.userIds 
                // 3. The authenticated user must be the explicit requester
                && request.auth.uid == request.resource.data.requesterId
                // 4. Validate the userIds array structure
                && request.resource.data.userIds.size() == 2
                // 5. User cannot send a request to themselves
                && request.resource.data.userIds[0] != request.resource.data.userIds[1];

      allow update: if isSignedIn() && resource.data.status == 'pending' && request.auth.uid != resource.data.requesterId && request.auth.uid in resource.data.userIds;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    /**
     * @description
     *   Stores daily questions that are available for all users to see. This data is considered public and is readable
     *   by anyone, including unauthenticated users. Writes are disabled for all clients.
     * @path /dailyQuestions/{dailyQuestionId}
     */
    match /dailyQuestions/{dailyQuestionId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description
     *   Stores 'What's New' announcements. This data is public and readable by any authenticated user.
     *   Only admins are allowed to create, update, or delete these announcements.
     * @path /whatsnew/{whatsNewId}
     */
    match /whatsnew/{whatsNewId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
