
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and reuse of logic.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // In a real app, use custom claims for roles: request.auth.token.admin == true
      return isSignedIn() && request.auth.token.email == 'rovinduthamu@gmail.com';
    }

    // Function to check if two users are friends by checking for an 'accepted' friendship document.
    function areFriends(userId1, userId2) {
      return exists(/databases/$(database)/documents/friendships) &&
             get(/databases/$(database)/documents/friendships).data.userIds.hasAll([userId1, userId2]) &&
             get(/databases/$(database)/documents/friendships).data.status == 'accepted';
    }

    /**
     * @description
     *   The User document contains public profile information and acts as the root for a user's private data.
     *   A user can create their own document and manage it, but cannot see other users unless they are an admin,
     *   or they are friends.
     * @path /users/{userId}
     */
    match /users/{userId} {
      // Allow owners, admins, or friends to view the main user profile.
      allow get: if isOwner(userId) || isAdmin() || (areFriends(request.auth.uid, userId));
      // Only admins can list all users to prevent user enumeration.
      allow list: if isAdmin();
      // A user can create their own document.
      allow create: if isOwner(userId);
      // Only the owner or an admin can update or delete the main user document.
      allow update, delete: if isOwner(userId) || isAdmin();
    }
    
    /**
     * @description
     *  Rules for all subcollections within a user's document.
     *  This single block secures /time_blocks, /todos, /settings, /privacy, etc.
     *  It ensures only the owner of the parent user document can read or write to any nested document.
     * @path /users/{userId}/{document=**}
     */
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    /**
     * @description
     *   Manages friendship connections. Users can send requests, and recipients can accept/decline.
     * @path /friendships/{friendshipId}
     */
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && resource.data.status == 'pending' && request.auth.uid != resource.data.requesterId && request.auth.uid in resource.data.userIds;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    /**
     * @description
     *   Stores daily questions that are available for all users to see. This data is considered public and is readable
     *   by anyone, including unauthenticated users. Writes are disabled for all clients.
     * @path /dailyQuestions/{dailyQuestionId}
     */
    match /dailyQuestions/{dailyQuestionId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description
     *   Stores 'What's New' announcements. This data is public and readable by any authenticated user.
     *   Only admins are allowed to create, update, or delete these announcements.
     * @path /whatsnew/{whatsNewId}
     */
    match /whatsnew/{whatsNewId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
